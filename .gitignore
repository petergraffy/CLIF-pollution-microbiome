# R specific gitignores
.Rprofile
.Rhistory
.Rprofile
.Ruserdata
.DS_Store
*.Rproj
.Rproj.user

## ignore the renv initialization file
initialize_renv.R

## ignore filtered CLIF tables stored as Rdata
*.RData

#ignore source CLIF_ files 
CLIF_*.parquet
CLIF_*.csv
CLIF_*.fst

#ignore the identifier app
CLIF_cohort_identifier*

# ignore file used to initialize renv when creating the template
initialize_renv.R

# ignore filtered CLIF tables stored as Rdata
*.RData

# ignore pdf reports and rendered html
*.pdf
*.html

# ignore generated local analysis outputs
output/final/*.csv
output/figures/*
!output/README.md

# MWAS: local clinical extracts, exposure caches, and generated run outputs
output/mwas/
data/mwas_cache/

# The public medication vocabulary is part of the reproducible site package.
!resources/mwas/clif_intermittent_med_categories.csv
dist/
__pycache__/

.venv-buddy/
renv/buddy-library/

# Public-data rebuilds use temporary download files; only finished national bundles are tracked.
data/public/**/*.partial
data/public/exposures/national-public-*/

# Pinned R activation is part of the site setup.
!.Rprofile
output/runs/
